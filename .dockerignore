# Файли й папки, які НЕ потрапляють у контекст збірки Docker (COPY . . їх не бачить)

# Залежності — в образі встановлюються заново через pnpm install
# (локальні містять бінарники під macOS і не підійдуть для Linux)
node_modules

# Результат збірки — в образі створюється заново через pnpm run build
dist

# Секрети — не повинні потрапити в образ; змінні передаються через env_file у compose
.env
.env.*

# Git та CI — для збірки не потрібні
.git
.gitignore
.github

# Налаштування редакторів
.idea
.vscode

# Тести та звіти покриття — для запуску в продакшені не потрібні
test
coverage

# Логи та системне сміття
*.log
.DS_Store

# Самі файли Docker і документація — в образі не потрібні
Dockerfile
.dockerignore
README.md
CLAUDE.md
